[Desktop Entry]
Type=Application
Name=Squads
GenericName=Microsoft Teams client
Comment=An alternative, cross-platform Microsoft Teams client built with Rust + egui
Exec=squads
Icon=dev.squads.squads
Terminal=false
Categories=Network;InstantMessaging;Chat;
Keywords=teams;chat;messaging;squads;
StartupNotify=true
# Must match `ViewportBuilder::with_app_id("dev.squads.squads")` in
# crates/squads-app/src/main.rs so the compositor associates the window with
# this entry (and shows the icon / groups the taskbar item).
StartupWMClass=dev.squads.squads
